# Copy to .env.local (gitignored) and fill in your key.
# Server-side fallback used when a request does not include the BYOK header.
OPENAI_API_KEY=

# Firebase / Firestore — required for caching, vector dish lookup, and image storage.
# Easiest: download the service-account JSON from Firebase Console and point GOOGLE_APPLICATION_CREDENTIALS to its absolute path.
GOOGLE_APPLICATION_CREDENTIALS=
# Storage bucket: typically "<projectId>.appspot.com" or "<projectId>.firebasestorage.app".
FIREBASE_STORAGE_BUCKET=vibemenu-55f2a.appspot.com

# Alternative to GOOGLE_APPLICATION_CREDENTIALS — paste credentials inline (escape newlines as \n in FIREBASE_PRIVATE_KEY).
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
