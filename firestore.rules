rules_version = '2';

// VibeMenu Firestore rules.
// All collections are accessed exclusively via the Firebase Admin SDK in our
// Next.js server routes, which bypasses these rules. Browser clients never
// talk to Firestore directly, so we deny everything by default.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
